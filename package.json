{
  "name": "plugin-importer",
  "version": "0.2.0",
  "description": "Recursively imports a plugin tree in order of dependencies",
  "homepage": "http://github.com/voxpelli/plugin-importer",
  "repository": {
    "type": "git",
    "url": "git://github.com/voxpelli/plugin-importer.git"
  },
  "keywords": [
    "plugins",
    "plugin-loader",
    "plugin-resolver",
    "plugin-system",
    "dependency-order",
    "topological-sort",
    "esm",
    "plugin-dependencies"
  ],
  "author": "Pelle Wessman <pelle@kodfabrik.se> (http://kodfabrik.se/)",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "typescript": ">=5.8"
  },
  "type": "module",
  "exports": "./index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "build:0": "run-s clean",
    "build:1-declaration": "tsc -p declaration.tsconfig.json",
    "build": "run-s build:*",
    "check-type-tests": "run-s build && tstyche --target \"$(node -p \"require('./package.json').engines.typescript\")\" --reporters list,summary && run-s clean",
    "check:installed-check": "installed-check -i tstyche",
    "check:knip": "knip",
    "check:lint": "eslint",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 99 --ignore-files 'test/*'",
    "check": "run-s clean && run-p check:* --continue-on-error && run-s check-type-tests",
    "clean:declarations-top": "rm -f $(find . -maxdepth 1 -type f -name '*.d.ts*' ! -name 'index.d.ts')",
    "clean:declarations-lib": "rm -f $(find lib -type f -name '*.d.ts*' ! -name '*-types.d.ts' 2>/dev/null || true)",
    "clean": "run-p clean:*",
    "husky-enable": "husky",
    "husky-disable": "git config --unset core.hooksPath",
    "prepublishOnly": "run-s build",
    "test:node": "c8 --reporter=lcov --reporter=text node --test",
    "test-ci": "run-s test:*",
    "test": "run-s check test:*"
  },
  "dependencies": {
    "@hapi/topo": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@types/sinon": "^17.0.4",
    "@voxpelli/eslint-config": "^23.0.0",
    "@voxpelli/tsconfig": "^16.1.0",
    "c8": "^11.0.0",
    "desm": "^1.3.1",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "installed-check": "^10.0.1",
    "knip": "^5.86.0",
    "npm-run-all2": "^8.0.4",
    "sinon": "^21.0.0",
    "tstyche": "^6.2.0",
    "type-coverage": "^2.29.7",
    "typescript": "~5.9.3",
    "validate-conventional-commit": "^1.0.4"
  }
}
